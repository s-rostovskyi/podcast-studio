# Copy to .env locally; replace the sample value with your own secret key.
OPENAI_API_KEY=sk-your-own-api-key-here
OPENAI_LLM_MODEL=gpt-4o-mini
# Optional: share a temporary Gradio URL while your computer stays online.
GRADIO_SHARE=0
# Optional, recommended on a public cloud deployment:
# GRADIO_AUTH_USER=demo
# GRADIO_AUTH_PASSWORD=choose-a-long-random-password
